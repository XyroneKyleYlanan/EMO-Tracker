{
  "version": 2,
  "regions": ["sin1"],
  "builds": [
    { "src": "/api/index.php", "use": "vercel-php@0.7.4" },
    { "src": "/public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/app/(.*)", "dest": "/public/app/$1" },
    { "src": "/(favicon\\.ico|robots\\.txt)", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
